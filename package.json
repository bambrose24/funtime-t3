{
  "name": "funtime-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run db:generate && turbo run build",
    "build-web": "turbo run db:generate && turbo run build --filter=@funtime/web",
    "web-cron": "cd apps/web && bun run cron",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "start-web": "cd apps/web && pnpm run start",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:pull": "turbo run db:pull",
    "db:studio": "turbo run db:studio",
    "prisma:migrate:check": "bun run scripts/prisma/validate-migrations.ts",
    "prisma:migrate:apply": "bun run scripts/prisma/validate-migrations.ts --apply",
    "season:validate-readonly": "bun run scripts/db/validate-season-readonly.ts",
    "season:import": "cd packages/api && bun run scripts/import-season.ts",
    "season:validate-import": "cd packages/api && bun run scripts/validate-season-import.ts",
    "e2e:fixtures:refresh": "bun run scripts/e2e/refresh-fixtures-from-live.ts",
    "e2e:fixtures:build-seed": "bun run scripts/e2e/generate-seed-from-fixture.ts",
    "e2e:backend:up": "bash scripts/e2e/backend-up.sh",
    "e2e:seed:verify": "bun run scripts/e2e/verify-seed.ts",
    "e2e:web": "bash scripts/e2e/run-web.sh",
    "e2e:web:seed": "bun run scripts/e2e/seed-web-fixtures.ts",
    "e2e:web:test": "playwright test",
    "e2e:mobile:install-dev-client": "bash scripts/e2e/install-dev-client.sh",
    "e2e:mobile:maestro": "bash scripts/e2e/run-maestro.sh",
    "posthog": "posthog-cli",
    "posthog:login": "posthog-cli login",
    "posthog:api": "posthog-cli api"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@posthog/cli": "0.18.0",
    "@types/eslint": "^9.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/ioredis": "^4.28.10",
    "@types/lodash": "^4.17.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "ajv": "^8.17.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.30.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5"
    }
  },
  "dependencies": {
    "ioredis": "^5.11.1"
  }
}
