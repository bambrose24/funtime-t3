{
  "name": "@funtime/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.4"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/prisma-client": "./src/generated/prisma-client/index.js",
    "./types": "./src/types.ts",
    "./db": "./server/db.ts",
    "./cache": "./server/cache.ts",
    "./env": "./env.js",
    "./trpc": "./trpc/server.ts",
    "./trpc/react": "./trpc/react.tsx",
    "./server/api/trpc": "./server/api/trpc.ts",
    "./server/api/root": "./server/api/root.ts",
    "./utils/config": "./utils/config.ts",
    "./utils/logging": "./utils/logging.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "email:dev": "email dev --dir emails --port 3001",
    "email:export": "email export --dir emails",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "DOTENV_CONFIG_PATH=../../.env.local prisma migrate dev",
    "db:migrate:create": "DOTENV_CONFIG_PATH=../../.env.local prisma migrate dev --create-only",
    "db:migrate:deploy": "DOTENV_CONFIG_PATH=../../.env.local prisma migrate deploy",
    "db:migrate:status": "DOTENV_CONFIG_PATH=../../.env.local prisma migrate status",
    "db:migrate:resolve": "DOTENV_CONFIG_PATH=../../.env.local prisma migrate resolve",
    "db:migrate:check": "bun run ../../scripts/prisma/validate-migrations.ts",
    "db:migrate:check:apply": "bun run ../../scripts/prisma/validate-migrations.ts --apply",
    "db:push": "DOTENV_CONFIG_PATH=../../.env.local prisma db push",
    "db:pull": "DOTENV_CONFIG_PATH=../../.env.local prisma db pull",
    "db:studio": "DOTENV_CONFIG_PATH=../../.env.local prisma studio"
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "dependencies": {
    "@axiomhq/winston": "^2.0.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@prisma/nextjs-monorepo-workaround-plugin": "^6.19.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "clsx": "^2.1.1",
    "cron": "^3.1.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "json-stable-stringify": "^1.3.0",
    "lodash": "^4.17.21",
    "react-email": "^6.9.3",
    "resend": "^6.25.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.12",
    "winston": "^3.13.0",
    "yup": "^1.4.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^24.13.3",
    "prisma": "^6.19.3",
    "typescript": "~6.0.3"
  }
}
