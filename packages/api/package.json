{
  "name": "@funtime/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.4"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/prisma-client": "./src/generated/prisma-client/client.ts",
    "./types": "./src/types.ts",
    "./db": "./server/db.ts",
    "./cache": "./server/cache.ts",
    "./env": "./env.js",
    "./trpc": "./trpc/server.ts",
    "./trpc/react": "./trpc/react.tsx",
    "./server/api/trpc": "./server/api/trpc.ts",
    "./server/api/root": "./server/api/root.ts",
    "./utils/weekSummary": "./utils/weekSummary.ts",
    "./utils/emailPreferences": "./utils/emailPreferences.ts",
    "./utils/emailStatus": "./utils/emailStatus.ts",
    "./utils/config": "./utils/config.ts",
    "./utils/weekPicksSort": "./utils/weekPicksSort.ts",
    "./utils/logging": "./utils/logging.ts",
    "./utils/pickPermissions": "./utils/pickPermissions.ts",
    "./utils/pickValidation": "./utils/pickValidation.ts",
    "./utils/messageReactions": "./utils/messageReactions.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "email:dev": "email dev --dir emails --port 3001",
    "email:export": "email export --dir emails",
    "test": "node --experimental-strip-types --test tests/*.test.mts && bun test ./tests/routers ./tests/week-to-pick.test.ts ./tests/email-preferences.test.ts ./tests/prisma-pg-config.test.ts ./tests/espn-load-or-skip.test.ts ./tests/message-reactions.test.ts ./tests/week-summary/summary.test.tsx ./tests/week-summary/preview.test.ts && bun test ./tests/week-summary-delivery.test.ts && bun test ./tests/pick-reminder-delivery.test.ts && bun test ./tests/resend-webhook-storage.test.ts && bun test ./tests/member-email-access.test.ts && bun test ./tests/espn-season-fetch.test.ts",
    "test:integration": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres E2E_MODE=1 FUNTIME_DISABLE_EMAILS=1 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421 NEXT_PUBLIC_SUPABASE_ANON_KEY=local-test bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:railway": "railway run --environment production --service web -- prisma migrate deploy",
    "db:migrate:railway:status": "railway run --environment production --service web -- prisma migrate status",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:migrate:check": "bun run ../../scripts/prisma/validate-migrations.ts",
    "db:migrate:check:apply": "bun run ../../scripts/prisma/validate-migrations.ts --apply",
    "db:schema-sync": "bun run ../../scripts/prisma/assert-schema-migrations-in-sync.ts",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@axiomhq/winston": "^2.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "clsx": "^2.1.1",
    "cron": "^3.1.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.3",
    "json-stable-stringify": "^1.3.0",
    "lodash": "^4.17.21",
    "pg": "^8.16.3",
    "react-email": "^6.9.3",
    "resend": "^6.25.0",
    "sanitize-html": "^2.17.5",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.12",
    "winston": "^3.13.0",
    "yup": "^1.4.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "7.10.0",
    "typescript": "~6.0.3"
  }
}
